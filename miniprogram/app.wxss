    --hero-halo-2:rgba(52,199,89,.14);
    --hero-halo-blur:16px;
    --hero-dots:rgba(255,255,255,.07);
    --chip-bg:rgba(255,255,255,.07);
    --chip-bd:rgba(255,255,255,.12);
    --noise-op:.035;
    --noise-blend:soft-light;
    --gb-face:linear-gradient(180deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,.08) 100%);
    --gb-face-2:linear-gradient(180deg,rgba(255,255,255,.11) 0%,rgba(255,255,255,.05) 100%);
    --gb-edge-hi:inset 0 .5px 0 rgba(255,255,255,.18);
    --gb-edge-lo:inset 0 -.5px 0 rgba(0,0,0,.34);
    --gb-hair:0 0 0 .5px rgba(255,255,255,.10);
    --gb-drop:0 1px 2px rgba(0,0,0,.34),0 8px 20px -10px rgba(0,0,0,.55);
    --gb-sheen:linear-gradient(180deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,.04) 42%,rgba(255,255,255,0) 62%);
    --gb-press-lift:inset 0 2px 6px rgba(0,0,0,.40);
