  --gb-tint-brand:linear-gradient(180deg,rgba(255,255,255,.18) 0%,rgba(255,255,255,.04) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(10,132,255,.62),rgba(10,132,255,.46));
  --gb-tint-red:linear-gradient(180deg,rgba(255,255,255,.18) 0%,rgba(255,255,255,.04) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(255,69,58,.62),rgba(255,69,58,.46));
  --gb-tint-green:linear-gradient(180deg,rgba(255,255,255,.18) 0%,rgba(255,255,255,.04) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(48,209,88,.58),rgba(48,209,88,.42));
  --gb-tint-amber:linear-gradient(180deg,rgba(255,255,255,.18) 0%,rgba(255,255,255,.04) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(255,159,10,.62),rgba(255,159,10,.46));
  --gb-tint-brand-hi:inset 0 1px 0 rgba(255,255,255,.34),inset 0 -.5px 0 rgba(255,255,255,.12),inset 0 -8px 14px -8px rgba(255,255,255,.16);
  --gb-tint-brand-edge:0 0 0 .5px rgba(102,171,255,.34);
  --gb-tint-red-edge:0 0 0 .5px rgba(255,138,128,.32);
  --gb-tint-green-edge:0 0 0 .5px rgba(110,231,183,.30);
  --gb-tint-amber-edge:0 0 0 .5px rgba(252,211,77,.30);

}
.theme-light{
  --bg-app:#F2F2F7;
  --surface:#FFFFFF;
  --surface-2:#FAFAFF;
  --surface-sunken:#F2F2F7;
  --surface-inverse:#1C1C1E;
  --text-1:#1D1D1F;
  --text-2:#3C3C43;
  --text-3:#6E6E73;
  --text-4:#8E8E93;
  --text-on-inverse:#F2F2F7;
  --brand-50:#E8F2FF;
  --brand-100:#CFE5FF;
  --brand-200:#9FCBFF;
  --brand-300:#66ABFF;
  --brand-400:#2E8DFF;
  --brand-500:#007AFF;
  --brand-600:#0064D6;
  --brand-700:#004FAD;
  --brand-gradient:linear-gradient(145deg,#2E8DFF 0%,#007AFF 46%,#004FAD 100%);
  --success-50:#E9F9EE;--success-100:#BFE9D7;--success-500:#34C759;--success-ink:#076B4A;
  --amber-50:#FFF5E6;--amber-100:#FCE4B0;--amber-500:#FF9500;--amber-ink:#96530A;
  --danger-50:#FFECEA;--danger-100:#FBC9C9;--danger-500:#FF3B30;--danger-ink:#B42318;
  --info-50:#E8F2FF;--info-500:#007AFF;--info-ink:#1D4ED8;
  --line-soft:#F2F2F7;
  --line:#E5E5EA;
  --line-strong:#D1D1D6;
  --track:#E5E5EA;
  --goal-1:#007AFF;--goal-2:#0EA5E9;--goal-3:#34C759;--goal-4:#FF9500;
  --goal-5:#FF3B30;--goal-6:#EC4899;--goal-7:#5856D6;--goal-8:#14B8A6;
  --sh-1:0 1px 2px 0 rgba(0,0,0,.04);
  --sh-2:0 1px 2px 0 rgba(0,0,0,.05), 0 1px 3px -1px rgba(0,0,0,.05);
  --sh-3:0 2px 4px -1px rgba(0,0,0,.06), 0 1px 2px -1px rgba(0,0,0,.05);
  --sh-accent:0 8px 24px -8px rgba(0,122,255,.28);
  --glass-bg:rgba(255,255,255,.80);
  --glass-bd:rgba(255,255,255,.65);
  /* 页面顶部的一层极淡色晕：纯色背景上玻璃是无形的，
     有了它，半透明浮层透过去才有层次。透明度压到 .05 附近，不能当装饰看 */
  --bg-glow:rgba(0,122,255,.055);
  --mask-bg:rgba(0,0,0,.35);
  --font-sans:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI Variable Text","PingFang SC","HarmonyOS Sans SC","Microsoft YaHei UI","Microsoft YaHei","Noto Sans SC",sans-serif;
  --font-mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --fs-display:clamp(40px,12vw,64px);
  --fs-num-lg:clamp(28px,8vw,40px);
  --fs-h1:clamp(24px,6.8vw,33px);
  --fs-h2:clamp(19.5px,5.2vw,24px);
  --fs-h3:clamp(17px,4.4vw,19.5px);
  --fs-body:clamp(15px,3.8vw,16px);
  --fs-sm:clamp(13px,3.2vw,14px);
  --fs-xs:clamp(11.5px,2.8vw,12.5px);
  --fs-nano:clamp(10.5px,2.6vw,11.5px);
  --fs-p1:clamp(44px,12vw,58px);
  --fw-normal:400;
  --fw-med:500;
  --fw-semi:600;
  --fw-bold:700;
  --fw-black:800;
  --ls-tight:-.02em;
  --ls-snap:-.01em;
  --ls-normal:0;
  --ls-label:.02em;
  --r-xs:8px;
  --r-sm:12px;
  --r-md:16px;
  --r-lg:20px;
  --r-xl:28px;
  --r-pill:999px;
  --pad-card:clamp(16px,4.2vw,22px);
  --pad-tight:14px;
  --pad-ctl:clamp(10px,2.6vw,12px);
  --pad-cell:12px 14px;
  --gap-card:clamp(12px,2.6vw,14px);
  --gap-block:clamp(22px,5vw,28px);
  --bg-app-2:#E5E5EA;
  --text-on-accent:#FFFFFF;
  --text-on-dark:#F2F2F7;
  --brand-gradient-soft:linear-gradient(145deg,#66ABFF 0%,#2E8DFF 100%);
  --success-600:#30D158;
  --amber-600:#FF9500;
  --danger-600:#FF453A;
  --info-100:#CFE5FF;
  --info-600:#0064D6;
  --line-dash:#C7C7CC;
  --grid-line:#F2F2F7;
  --gc-6366f1:var(--goal-1);
  --gc-f59e0b:var(--goal-4);
  --gc-10b981:var(--goal-3);
  --gc-0ea5e9:var(--goal-2);
  --gc-8b5cf6:var(--goal-7);
  --gc-ef4444:var(--goal-5);
  --gc-f97316:var(--goal-4);
  --gc-14b8a6:var(--goal-8);
  --sh-0:0 1px 2px -1px rgba(0,0,0,.04);
  --sh-inset-hi:inset 0 1px 0 rgba(255,255,255,.62);
  --sh-inset-lo:inset 0 -1px 0 rgba(0,0,0,.06);
  --hero-grad:linear-gradient(165deg,#0064D6 0%,#007AFF 58%,#2E8DFF 100%);
  --hero-halo-1:rgba(46,141,255,.30);
  --hero-halo-2:rgba(52,199,89,.18);
  --hero-halo-blur:10px;
  --hero-dots:rgba(255,255,255,.16);
  --chip-bg:rgba(255,255,255,.16);
  --chip-bd:rgba(255,255,255,.25);
  --noise-op:.018;
  --noise-blend:overlay;
  --gb-blur:blur(24px) saturate(190%);
  --gb-blur-sm:blur(16px) saturate(180%);
  /* 液态玻璃档：低模糊 + 高饱和 —— 中心透出内容色，靠边缘亮环与镜面给「液」感。
     磨砂档 blur(16px) 保留给面板（弹层 / 横幅 / 状态条），按键不用它 */
  --gb-blur-liq:blur(8px) saturate(200%);
  --gb-face:linear-gradient(180deg,rgba(255,255,255,.92) 0%,rgba(255,255,255,.60) 100%);
  --gb-face-2:linear-gradient(180deg,rgba(255,255,255,.42) 0%,rgba(255,255,255,.16) 100%);
  --gb-edge-hi:inset 0 .5px 0 rgba(255,255,255,.92);
  --gb-edge-lo:inset 0 -.5px 0 rgba(15,23,42,.06);
  --gb-hair:0 0 0 .5px rgba(15,23,42,.08);
  --gb-drop:0 2px 8px rgba(15,23,42,.10),0 8px 20px -8px rgba(15,23,42,.24);
  --gb-sheen:linear-gradient(180deg,rgba(255,255,255,.58) 0%,rgba(255,255,255,.16) 42%,rgba(255,255,255,0) 62%);
  --gb-press-lift:inset 0 2px 6px rgba(15,23,42,.10);
  /* tint 是「染色玻璃」不是实心底：上层白玻璃提亮（光感），下层染色只到 ~52%，
     底下内容经 blur 后的颜色能透上来 —— 这才是 iOS 液态玻璃的透明度 */
  --gb-tint-brand:linear-gradient(180deg,rgba(255,255,255,.26) 0%,rgba(255,255,255,.05) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(0,122,255,.54),rgba(0,122,255,.38));
  --gb-tint-red:linear-gradient(180deg,rgba(255,255,255,.26) 0%,rgba(255,255,255,.05) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(255,59,48,.54),rgba(255,59,48,.38));
  --gb-tint-green:linear-gradient(180deg,rgba(255,255,255,.26) 0%,rgba(255,255,255,.05) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(52,199,89,.54),rgba(52,199,89,.38));
  --gb-tint-amber:linear-gradient(180deg,rgba(255,255,255,.26) 0%,rgba(255,255,255,.05) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(255,149,0,.56),rgba(255,149,0,.40));
  /* hi 三件：顶缘亮线（1px，玻璃上最亮的一笔）+ 底缘反光 + 底部内弹光 */
  --gb-tint-brand-hi:inset 0 1px 0 rgba(255,255,255,.58),inset 0 -.5px 0 rgba(255,255,255,.22),inset 0 -8px 14px -8px rgba(255,255,255,.30);
  --gb-tint-brand-edge:0 0 0 .5px rgba(0,84,190,.42);
  --gb-tint-red-edge:0 0 0 .5px rgba(190,32,24,.42);
  --gb-tint-green-edge:0 0 0 .5px rgba(24,150,60,.42);
  --gb-tint-amber-edge:0 0 0 .5px rgba(190,105,0,.42);
  --bg:var(--bg-app);
  --card:var(--surface);
  --ink:var(--text-1);
  --ink-2:var(--text-2);
  --ink-3:var(--text-3);
  --brand:var(--brand-500);
  --brand-2:var(--brand-600);
  --green:var(--success-600);
  --red:var(--danger-600);
  --amber:var(--amber-600);
  --radius:var(--r-lg);
  --shadow:var(--sh-2);
  --shadow-lg:var(--sh-3);

}

/* ---------- 页面骨架 ----------
   .page 自己带底色：手动主题覆盖时 page 元素本身的背景改不了
   （配色方案由系统决定），所以由这个容器撑满视口并铺底色。 */
.page{
  min-height:100vh;
  background-color:var(--bg-app);
  /* 顶部一层几乎看不见的色晕。纯色背景上的玻璃是「无色可透」的，
     有了它，半透明浮层透过去才有层次；透明度压在 .05~.09，不当装饰用 */
  background-image:radial-gradient(120% 70% at 50% 0%, var(--bg-glow), transparent 68%);
  background-repeat:no-repeat;
  padding:calc(var(--gap-block) * .7) var(--pad-page) var(--pad-nav);
}
/* hero 组件宿主：hero 底缘到首个板块的间距基准，四个页签统一由这里出。
   首个板块（统计条 / 周切换卡 / 空态卡）不再各自带 margin-top——
   之前 0/10/12px 混着用，切页签时第一张卡的起点会跳。 */
app-hero{ display:block; margin-bottom:10px; }

.page-title{
  font-size:var(--fs-h1);
  font-weight:800;
  letter-spacing:var(--ls-tight);
  line-height:1.2;
  color:var(--text-1);
}
.page-sub{
  margin-top:6rpx;
  font-size:var(--fs-xs);
  color:var(--text-3);
}
.section-title{
  font-size:var(--fs-xs);
  font-weight:600;
  letter-spacing:var(--ls-label);
  color:var(--text-3);
  margin:var(--gap-block) 0 clamp(8px,2vw,10px) 2px;
}

/* ---------- 卡片 ---------- */
.card{
  background:var(--surface);
  border-radius:var(--r-lg);
  box-shadow:var(--sh-2);
  padding:var(--pad-card);
}
.card + .card{ margin-top:var(--gap-card); }
.card-title{
  display:flex;
  align-items:center;
  gap:8rpx;
  font-size:var(--fs-h3);
  font-weight:800;
  letter-spacing:var(--ls-snap);
  color:var(--text-1);
}
.card-title::before{
  content:"";
  width:6rpx;height:28rpx;border-radius:2px;
  background:currentColor;opacity:.85;flex:none;
}
.card-sub{
  margin-top:6rpx;
  font-size:var(--fs-sm);
  color:var(--text-3);
  line-height:1.6;
}
.card-body{ margin-top:14px; }

/* ---------- 设置行 / 行式按钮 ---------- */
.row{
  display:flex;
  align-items:center;
  gap:12rpx;
  min-height:calc(52px + 0rpx);
  padding:14rpx 0;
  border-bottom:1rpx solid var(--line-soft);
}
.row:last-child{ border-bottom:none; }
.row-label{ flex:1; min-width:0; font-size:var(--fs-body); color:var(--text-1); }
.row-sub{ margin-top:2rpx; font-size:var(--fs-xs); color:var(--text-3); }
.row-value{ font-size:var(--fs-sm); color:var(--text-3); }

/* ---------- 按钮 ---------- */
.btn{
  display:flex;align-items:center;justify-content:center;gap:8rpx;
  /* iOS 大键 = 50pt 胶囊，semibold + 收紧字距 */
  width:100%;height:calc(50px);
  border-radius:var(--r-pill);
  /* 液态玻璃的镜面高光层挂在 ::after 上，这里要给它定位基准 */
  position:relative;
  overflow:hidden;
  border:none;
  font-size:var(--fs-body);
  font-weight:600;
  letter-spacing:var(--ls-snap);
  line-height:1;
  transition:transform .12s ease-out,opacity .12s ease-out;
}
.btn::after{ border:none; }
/* iOS 的按压是透明度衰减（highlight），不是变暗 */
.btn:active{ transform:scale(.97);opacity:.85; }
.btn-primary{
  background:var(--gb-tint-brand);
  color:var(--text-on-accent);
  -webkit-backdrop-filter:var(--gb-blur-liq);
  backdrop-filter:var(--gb-blur-liq);
  box-shadow:var(--gb-tint-brand-hi),var(--gb-tint-brand-edge),var(--gb-drop);
 }
/* 次级按钮 = iOS 的 systemGray5 灰底胶囊（SwiftUI .bordered 的灰）。
   玻璃只留给栏与浮层（iOS 本来就用玻璃的地方），
   内容区的次级操作用灰底——这是原生 iOS 最有辨识度的按键样式。 */
.btn-ghost{
  background:var(--surface-sunken);
  color:var(--text-1);
  box-shadow:none;
}
.btn-plain{ background:transparent; color:var(--brand-500); box-shadow:none; }
.btn-danger{
  background:var(--gb-tint-red);
  color:#fff;
  -webkit-backdrop-filter:var(--gb-blur-liq);
  backdrop-filter:var(--gb-blur-liq);
  box-shadow:var(--gb-tint-red-edge),var(--gb-drop);
 }

/* 液态玻璃的「湿感」来自顶部镜面反光：所有染色/清玻璃按键统一挂这层。
   app.wxss 对全部页面生效，一处写完，页面不再各配一份。 */
.btn-primary::after,
.btn-danger::after,
.btn-wx::after,
.fk-btn::after{
  content:"";
  position:absolute;
  left:0;top:0;right:0;bottom:0;  /* inset 的四边回退：旧内核不认简写，缺了会塌成零尺寸 */
  inset:0;
  border-radius:inherit;
  pointer-events:none;
  background:linear-gradient(180deg,rgba(255,255,255,.55) 0%,rgba(255,255,255,.16) 30%,rgba(255,255,255,0) 55%);
}

/* 半透染色玻璃上的白字要立得住：轻投影是 iOS 的做法 */
.btn-primary,
.btn-danger,
.btn-wx,
.fk-btn{
  text-shadow:0 1px 2px rgba(0,0,0,.18);
}
.btn[disabled]{ opacity:.4; box-shadow:none; text-shadow:none; }
.btn-sm{ height:calc(38px); font-size:var(--fs-sm); border-radius:var(--r-pill); width:auto; padding:0 20rpx; }

/* ---------- 输入 ---------- */
.field{ margin-top:16px; }
.field-label{
  display:block;
  font-size:var(--fs-xs);
  font-weight:600;
  color:var(--text-3);
  margin-bottom:6px;
}
.input{
  width:100%;
  height:calc(46px);
  padding:0 14px;
  background:var(--surface-sunken);
  border-radius:var(--r-sm);
  border:1.5rpx solid transparent;
  font-size:var(--fs-body);
  color:var(--text-1);
  transition:border-color .18s ease-out,box-shadow .18s ease-out;
}
.input.is-focus,
.input:focus{
  border-color:var(--brand-400);
  box-shadow:0 0 0 6rpx rgba(0,122,255,.14);
  outline:none;
}
.input.is-error{ border-color:var(--danger-500); }
.field-hint{ margin-top:6px; font-size:var(--fs-xs); color:var(--text-3); line-height:1.5; }
.field-hint.is-error{ color:var(--danger-ink); }

/* 分段控件（登录 / 注册 / 找回） */
.segmented{
  display:flex;
  padding:2px;
  background:var(--surface-sunken);
  border-radius:var(--r-sm);
  gap:2px;
}
.segmented-item{
  flex:1;
  height:calc(38px);
  display:flex;align-items:center;justify-content:center;
  border-radius:calc(var(--r-sm) - 1px);
  font-size:var(--fs-sm);
  font-weight:600;
  color:var(--text-3);
  transition:background .18s ease-out,color .18s ease-out;
}
.segmented-item.is-on{ background:var(--surface); color:var(--brand-500); box-shadow:var(--sh-1); }

/* ---------- 徽标 / 圆点 ---------- */
.dot{ width:14rpx;height:14rpx;border-radius:50%;flex:none;background:var(--text-4); }
.dot.ok{ background:var(--success-500); }
.dot.sync{ background:var(--brand-500); }
.dot.warn{ background:var(--amber-500); }
.dot.err{ background:var(--danger-500); }
.dot.off{ background:var(--text-4); }

.badge{
  display:inline-flex;align-items:center;gap:8rpx;
  height:calc(24px);
  padding:0 12rpx;
  border-radius:var(--r-pill);
  font-size:var(--fs-nano);
  font-weight:600;
  background:var(--surface-sunken);
  color:var(--text-3);
}
.badge-ok{ background:var(--success-50); color:var(--success-ink); }
.badge-warn{ background:var(--amber-50); color:var(--amber-ink); }
.badge-err{ background:var(--danger-50); color:var(--danger-ink); }
.badge-brand{ background:var(--brand-50); color:var(--brand-600); }

/* ---------- 进度条 ---------- */
.bar{
  height:10px;border-radius:var(--r-pill);
  background:var(--surface-sunken);
  overflow:hidden;
  box-shadow:inset 0 1px 2px rgba(0,0,0,.06);
}
.bar > .fill{
  height:100%;border-radius:var(--r-pill);
  background:linear-gradient(90deg,var(--brand-400),var(--brand-600));
  transition:width .5s cubic-bezier(.22,1,.36,1);
}
.bar > .fill.is-done{ background:linear-gradient(90deg,var(--success-500),var(--success-600)); }
.bar > .fill.is-over{ background:linear-gradient(90deg,var(--danger-500),var(--danger-600)); }

/* ---------- 空态 ---------- */
.empty{
  padding:clamp(28px,7vw,40px) 16px;
  text-align:center;
}
.empty-title{ font-size:var(--fs-h3); font-weight:700; color:var(--text-1); }
.empty-desc{ margin-top:8px; font-size:var(--fs-sm); color:var(--text-3); line-height:1.65; }
.empty-actions{ margin-top:18px; display:flex; flex-direction:column; gap:10px; }

/* ---------- 列表项（目标） ---------- */
.goal{
  background:var(--surface);
  border-radius:var(--r-lg);
  box-shadow:var(--sh-2);
  padding:var(--pad-card);
  position:relative;
  overflow:hidden;
}
.goal::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:6rpx;
  background:var(--gc,var(--brand-500));
}
.goal-head{ display:flex;align-items:flex-start;gap:12rpx; }
.goal-name{
  flex:1;min-width:0;
  font-size:var(--fs-body);font-weight:600;letter-spacing:var(--ls-snap);
  color:var(--text-1);
}
.goal-meta{ margin-top:8rpx;font-size:var(--fs-xs);color:var(--text-3); }
.goal-meta .sep{ margin:0 6rpx;opacity:.5; }
.goal-bar{ margin-top:14rpx; }
.goal-foot{
  display:flex;align-items:center;justify-content:space-between;
  margin-top:10rpx;font-size:var(--fs-xs);color:var(--text-3);
}
.goal-foot .num{ font-variant-numeric:tabular-nums;color:var(--text-2);font-weight:600; }

/* ---------- 数字 ---------- */
.num{ font-variant-numeric:tabular-nums lining-nums; }

/* ---------- 分隔 ---------- */
.hr{ height:1rpx;background:var(--line);margin:14px 0; }
.hr-soft{ height:1rpx;background:var(--line-soft); }

/* ---------- 玻璃遮罩层（弹层） ---------- */
.mask{
  position:fixed;left:0;top:0;right:0;bottom:0;inset:0;z-index:900;
  background:var(--mask-bg);
  /* 虚化身后的页面：这是「弹出层」最便宜也最有效的一层玻璃语言。
     不支持 backdrop-filter 时只是没有虚化，遮罩底色仍在，不会破版 */
  -webkit-backdrop-filter:blur(3px);
  backdrop-filter:blur(3px);
  display:flex;align-items:flex-end;
}
/**
 * 底部弹层：磨砂玻璃面板。
 * 降级是「自带」的，不需要 @supports：
 *   - 不支持 backdrop-filter 时，只剩 --glass-bg 这层 80% 不透明的底色
 *     （浅色主题 rgba(255,255,255,.80)、深色 rgba(28,28,30,.74)），文字照样可读；
 *   - 上缘高光与投影是普通 box-shadow，任何机型都在。
 */
.sheet{
  width:100%;
  max-height:88vh;
  background:var(--glass-bg);
  -webkit-backdrop-filter:var(--gb-blur);
  backdrop-filter:var(--gb-blur);
  border-radius:var(--r-xl) var(--r-xl) 0 0;
  box-shadow:inset 0 .5px 0 rgba(255,255,255,.65), 0 -14px 44px -14px rgba(15,23,42,.26);
  padding:var(--pad-card) var(--pad-page) calc(var(--pad-card) + env(safe-area-inset-bottom));
  animation:sheetUp .26s cubic-bezier(.22,1,.36,1);
}
@keyframes sheetUp{ from{ transform:translateY(100%); } to{ transform:translateY(0); } }
.sheet-grab{
  width:72rpx;height:8rpx;border-radius:var(--r-pill);
  background:var(--line-strong);margin:0 auto 16rpx;
}
.sheet-title{ font-size:var(--fs-h2);font-weight:700;letter-spacing:var(--ls-snap); }
.sheet-actions{ margin-top:22px;display:flex;gap:12px; }
.sheet-actions .btn{ flex:1; }

/* ---------- Toast ---------- */
.toast{
  position:fixed;
  left:50%;bottom:calc(var(--pad-nav) + 20rpx);
  transform:translateX(-50%) translateY(8px);
  max-width:80vw;
  padding:14rpx 26rpx;
  border-radius:var(--r-pill);
  background:var(--surface-inverse);
  color:var(--text-on-inverse);
  font-size:var(--fs-sm);
  box-shadow:var(--sh-3);
  z-index:1000;
  opacity:0;
  pointer-events:none;
  transition:opacity .18s ease-out,transform .18s ease-out;
}
.toast.is-on{ opacity:1;transform:translateX(-50%) translateY(0); }

/* ---------- 动画降级 ---------- */
@media (prefers-reduced-motion: reduce){
  .sheet{ animation:none; }
  .toast{ transition:none; }
  .bar > .fill{ transition:none; }
  .btn:active{ transform:none; }
}

/* =====================================================================
   hover-class 按压态（全局基础规则）
   :active 在开发者工具有「粘滞」怪癖（点击后卡住、下次点击才释放），
   观感就是「再点同一颗才动」。hover-class 由框架在每次触摸期间挂类，
   模拟器与真机都逐次必触发。0ms 进入、120ms 回弹。2026-10-26 重补：
   上一笔提交时本规则被并行会话回滚，导致按压态整体失效。
   ===================================================================== */
/* 短按也能看到完整「按下弹起」：类一挂就播完整弹跳（与触摸时长无关），
   动画结束后长按者停在 scale(.94) 的持续按压态，松手走过渡弹回 */
.is-press{ transform:scale(.94);opacity:.82;animation:pressPop .24s ease-out; }
@keyframes pressPop{
  0%{ transform:scale(1); }
  40%{ transform:scale(.945); }
  100%{ transform:scale(1); }
}
