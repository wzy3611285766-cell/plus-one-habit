  --noise-op:.035;
  --noise-blend:soft-light;
  --gb-face:linear-gradient(180deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,.08) 100%);
  --gb-face-2:linear-gradient(180deg,rgba(255,255,255,.11) 0%,rgba(255,255,255,.05) 100%);
  --gb-edge-hi:inset 0 .5px 0 rgba(255,255,255,.18);
