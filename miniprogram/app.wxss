  --success-50:rgba(48,209,88,.13);--success-100:rgba(48,209,88,.28);--success-500:#30D158;--success-ink:#6EE7B7;
  --amber-50:rgba(255,159,10,.13);--amber-100:rgba(255,159,10,.28);--amber-500:#FFB340;--amber-ink:#FCD34D;
  --danger-50:rgba(255,69,58,.13);--danger-100:rgba(255,69,58,.28);--danger-500:#FF453A;--danger-ink:#FCA5A5;
  --info-50:rgba(66,165,255,.13);--info-500:#66ABFF;--info-ink:#93C5FD;
  --line-soft:#1C1C1E;
  --line:#2C2C2E;
  --line-strong:#3A3A3C;
  --track:#2C2C2E;
  --goal-1:#66ABFF;--goal-2:#38BDF8;--goal-3:#30D158;--goal-4:#FF9F0A;
  --goal-5:#FF453A;--goal-6:#F472B6;--goal-7:#A5B4FC;--goal-8:#5EEAD4;
  --sh-1:0 1px 2px 0 rgba(0,0,0,.30);
  --sh-2:0 1px 2px 0 rgba(0,0,0,.36), 0 1px 3px -1px rgba(0,0,0,.36);
  --sh-3:0 2px 4px -1px rgba(0,0,0,.40), 0 1px 2px -1px rgba(0,0,0,.36);
  --sh-accent:0 8px 26px -6px rgba(46,141,255,.55);
  --glass-bg:rgba(28,28,30,.74);
  --glass-bd:rgba(255,255,255,.06);
  --bg-glow:rgba(102,171,255,.09);
  --mask-bg:rgba(0,0,0,.62);
  --bg-app-2:#0B0C14;
  --text-on-accent:#FFFFFF;
  --text-on-dark:#F2F2F7;
  --brand-gradient-soft:linear-gradient(145deg,#2E8DFF 0%,#66ABFF 100%);
  --success-600:#34C759;
  --amber-600:#FF9F0A;
  --danger-600:#FF3B30;
  --info-100:rgba(66,165,255,.28);
  --info-600:#2E8DFF;
  --line-dash:#48484A;
  --grid-line:rgba(255,255,255,.06);
  --sh-0:0 1px 2px -1px rgba(0,0,0,.30);
  --sh-inset-hi:inset 0 1px 0 rgba(255,255,255,.055);
  --sh-inset-lo:inset 0 -1px 0 rgba(0,0,0,.30);
  --hero-grad:linear-gradient(165deg,#00275A 0%,#003B82 55%,#004FAD 100%);
