view,text,button,input,textarea,scroll-view,image{ box-sizing:border-box; }

/* ---------- 手动主题覆盖 ----------
   小程序没有「强制指定配色方案」的官方 API：app.json 的 darkmode 只能跟随系统。
   要在系统是浅色时强制深色（或反之），只能自己把 token 再声明一遍。
   这两份 token 与上面的 @media 块内容相同 —— 有意的重复：
   采用「重复声明」而不是「提取公共类」，是因为 WXSS 不支持 token 集的复用语法，
   而把每一档都写成独立、完整、可直接对照的整块，比拆成互相覆盖的碎片更好维护。
   改动其中一处时必须同步另外两处（tests/static.test.mjs 会检查三处的 token 数量一致）。 */
.theme-dark{
  --bg-app:#000000;
  --surface:#1C1C1E;
  --surface-2:#2C2C2E;
  --surface-sunken:#0B0C14;
  --surface-inverse:#F2F2F7;
  --text-1:#F2F2F7;
  --text-2:#E5E5EA;
  --text-3:#8E8E93;
  --text-4:#636366;
  --text-on-inverse:#1D1D1F;
  --brand-50:#00275A;
  --brand-100:#003B82;
  --brand-200:#004FAD;
  --brand-300:#0064D6;
  --brand-400:#2E8DFF;
