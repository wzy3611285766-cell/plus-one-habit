/* 我的 —— 对齐 design-baseline.html 的 #panel-mine（第 915–1000 / 1259 行）
 *
 * 形态是 iOS 设置页：分组卡片 + 发丝分隔线 + 行内按下高光。
 * 与基准的唯一结构差异：顶部多一行「账号」，否则未登录时没有登录入口。
 */

.mine{ padding-bottom:calc(var(--pad-nav) + 20rpx); }

/* =====================================================================
   分组列表
   ===================================================================== */
.card-title .title-dot{
  flex:none;
  width:3px;height:14px;
  border-radius:2px;
  background:var(--brand-500);
}
.title-dot.is-green{ background:var(--success-500); }

.mine-list{ margin:0 calc(var(--pad-card) * -1); }

.mine-btn{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:52px;
  padding:10px var(--pad-card);
  border-bottom:.5px solid var(--line);
  background:none;
  font-size:var(--fs-body);
  font-weight:500;
  color:var(--text-1);
  transition:background .14s ease-out,box-shadow .14s ease-out;
}
.mine-list .mine-btn:last-child{ border-bottom:0; }
.mine-btn:active{
  /* iOS 列表行的高亮是中性灰（设置 App 的行为），不是品牌色 */
  background:rgba(120,120,128,.16);
  box-shadow:none;
}
.mine-btn.danger{ color:var(--danger-ink); }
.mine-btn.danger .mine-ico{ color:var(--danger-500); }
.mine-btn.danger:active{ background:rgba(120,120,128,.16); }

.mine-body{
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  text-align:left;
}
.mine-txt{
  display:block;
  font-size:var(--fs-body);
  font-weight:500;
  color:inherit;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.mine-sub{
  display:block;
  margin-top:1px;
  font-size:var(--fs-nano);
  font-weight:400;
  color:var(--text-3);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

/* ---------- 行内图标（B 方案：圆润品牌线性，2px，21px） ----------
   用 CSS mask + 内联 SVG：颜色跟 currentColor 走（深色/危险态自动适配），
   不引入任何位图，也不依赖字体文件。旧 CSS 画笔触的 ::before/::after 全部停用。 */
.mine-ico{
  flex:none;
  width:21px;
  height:21px;
  color:var(--brand-500);
  background-color:currentColor;
  -webkit-mask-repeat:no-repeat;
  -webkit-mask-position:center;
  -webkit-mask-size:contain;
  mask-repeat:no-repeat;
  mask-position:center;
  mask-size:contain;
}
.mine-ico::before,
.mine-ico::after{ content:none; }
.mine-ico::before,
.mine-ico::after{
  content:"";
  position:absolute;
}

/* 人形：头 + 肩 */
.ico-user::before{
  left:5.5px;top:0;
  width:6px;height:6px;
  border:1.6px solid currentColor;
  border-radius:50%;
  box-sizing:border-box;
}
.ico-user::after{
  left:2px;top:9px;
  width:13px;height:6px;
  border:1.6px solid currentColor;
  border-bottom:0;
  border-radius:50% 50% 0 0 / 100% 100% 0 0;
  box-sizing:border-box;
}

/* 音量：三根高低竖条 */
.ico-vol::before{
  left:1px;top:7px;
  width:2.4px;height:3px;
  background:currentColor;
  border-radius:1px;
  box-shadow:4px -4px 0 currentColor, 8px -7px 0 currentColor;
}
.ico-vol::after{
  left:1px;bottom:0;
  width:10.4px;height:2.4px;
  border-radius:2px;
  background:transparent;
}

/* 深色模式：月亮 */
.ico-theme::before{
  left:1px;top:1px;
  width:13px;height:13px;
  border:1.6px solid currentColor;
  border-radius:50%;
  box-sizing:border-box;
  background:transparent;
}
.ico-theme::after{
  left:6px;top:-1px;
  width:13px;height:15px;
  border-radius:50%;
  background:var(--surface);
  box-shadow:inset 1px 0 0 0 var(--surface);
}

/* 下载：箭头 + 底线 */
.ico-download::before{
  left:7.5px;top:1px;
  width:1.8px;height:8px;
  background:currentColor;
}
.ico-download::after{
  left:4.5px;top:6px;
  width:8px;height:8px;
  border-right:1.8px solid currentColor;
  border-bottom:1.8px solid currentColor;
  transform:rotate(45deg);
  transform-origin:60% 60%;
  box-sizing:border-box;
}

/* 垃圾桶：盖子 + 桶身 */
.ico-trash::before{
  left:1px;top:2px;
  width:15px;height:1.8px;
  border-radius:1px;
  background:currentColor;
}
.ico-trash::after{
  left:3px;top:4px;
  width:11px;height:12px;
  border:1.6px solid currentColor;
  border-top:0;
  border-radius:0 0 2px 2px;
  box-sizing:border-box;
}

/* 云端：云朵 */
.ico-cloud::before{
  left:1px;top:5px;
  width:14px;height:8px;
  border:1.6px solid currentColor;
  border-radius:999rpx;
  box-sizing:border-box;
}

/* 退出：门 + 箭头 */
.ico-out::before{
  left:1px;top:1px;
  width:9px;height:15px;
  border:1.6px solid currentColor;
  border-right:0;
  border-radius:2px 0 0 2px;
  box-sizing:border-box;
}
.ico-out::after{
  left:9px;top:8px;
  width:7px;height:1.8px;
  background:currentColor;
}

/* =====================================================================
   iOS 开关
   ===================================================================== */
.switch{
  position:relative;
  flex:none;
  width:46px;
  height:28px;
  border-radius:999rpx;
  background:rgba(120,120,128,.22);
  transition:background .2s ease-out;
}
.switch.on{ background:var(--brand-500); }
.knob{
  position:absolute;
  left:2px;top:2px;
  width:24px;height:24px;
  border-radius:50%;
  background:#fff;
  box-shadow:0 2px 4px rgba(0,0,0,.18),0 0 0 .5px rgba(0,0,0,.04);
  transition:transform .2s cubic-bezier(.22,1,.36,1);
}
.switch.on .knob{ transform:translateX(18px); }

/* =====================================================================
   音量滑块
   ===================================================================== */
.mine-vol{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:52px;
  padding:10px var(--pad-card);
  border-bottom:.5px solid var(--line);
}
.vol-bar-wrap{
  flex:none;
  width:clamp(120px, 44vw, 180px);
  height:44px;               /* 视觉只有 9px，但触控区给足 44px */
  display:flex;align-items:center;
}
.vol-bar{
  position:relative;
  width:100%;height:9px;
  border-radius:999rpx;
  overflow:hidden;
  background:rgba(120,120,128,.20);
  box-shadow:0 2px 12px rgba(99,102,241,.22);
}
/* 流动的彩色渐变：比条宽 3 倍，来回平移，颜色一直在走 */
.vol-flow{
  position:absolute;left:0;top:0;right:0;bottom:0;
  background:linear-gradient(90deg,
    #6366f1 0%, #0ea5e9 20%, #10b981 38%, #f59e0b 56%, #ef4444 74%, #8b5cf6 88%, #6366f1 100%);
  background-size:300% 100%;
  animation:volFlow 4.2s ease-in-out infinite alternate;
}
@keyframes volFlow{
  from{ background-position:0% 50%; }
  to{ background-position:100% 50%; }
}
/* 一道掠过的高光，让条子有“活着”的感觉 */
.vol-shine{
  position:absolute;top:-2px;bottom:-2px;width:38%;
  background:linear-gradient(90deg,
    rgba(255,255,255,0), rgba(255,255,255,.42), rgba(255,255,255,0));
  transform:translateX(-140%);
  animation:volShine 2.8s ease-in-out infinite;
  pointer-events:none;
}
@keyframes volShine{
  0%, 18%{ transform:translateX(-140%); opacity:0; }
  35%{ opacity:1; }
  70%, 100%{ transform:translateX(300%); opacity:0; }
}
/* 微粒：大小 1.5~2.5px，错开延迟上浮 + 闪烁 */
.vol-particle{
  position:absolute;
  width:2px;height:2px;
  border-radius:50%;
  background:#fff;
  opacity:0;
  box-shadow:0 0 5px rgba(255,255,255,.95);
  animation:volTwinkle 2.4s ease-in-out infinite;
  pointer-events:none;
}
.vol-particle.p1{ left:7%;  top:3px; animation-delay:-0.2s; }
.vol-particle.p2{ left:19%; top:2px; animation-delay:-1.1s; animation-duration:2.9s; background:#a5f3fc; box-shadow:0 0 6px rgba(165,243,252,.95); }
.vol-particle.p3{ left:33%; top:4px; animation-delay:-0.6s; animation-duration:2.1s; }
.vol-particle.p4{ left:48%; top:2px; animation-delay:-1.7s; animation-duration:3.1s; background:#fbcfe8; box-shadow:0 0 6px rgba(251,207,232,.95); }
.vol-particle.p5{ left:62%; top:3px; animation-delay:-0.9s; animation-duration:2.6s; }
.vol-particle.p6{ left:77%; top:2px; animation-delay:-2.0s; animation-duration:3.3s; background:#bbf7d0; box-shadow:0 0 6px rgba(187,247,208,.95); }
.vol-particle.p7{ left:90%; top:4px; animation-delay:-1.3s; animation-duration:2.2s; }
@keyframes volTwinkle{
  0%, 100%{ opacity:0; transform:translateY(1.5px) scale(.5); }
  35%{ opacity:.95; transform:translateY(-2px) scale(1); }
  65%{ opacity:.35; transform:translateY(-1px) scale(.75); }
}
.vol-dim{
  position:absolute;right:0;top:0;height:100%;
  background:var(--surface);
  opacity:.78;
  border-radius:0 999rpx 999rpx 0;
  transition:width .06s linear;
}

/* =====================================================================
   在线同步
   ===================================================================== */
.sync-box{ display:flex;flex-direction:column;gap:10px; }

.sync-row{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:var(--fs-sm);
  color:var(--text-2);
}
.sync-dot{
  flex:none;
  width:9px;height:9px;
  border-radius:50%;
  background:var(--text-4);
}
.sync-dot.ok{ background:var(--success-500); }
.sync-dot.sync{ background:var(--brand-500);animation:syncPulse 1.1s ease-in-out infinite; }
.sync-dot.err{ background:var(--danger-500); }
.sync-dot.off{ background:var(--text-4); }
@keyframes syncPulse{
  0%,100%{ opacity:1;transform:scale(1); }
  50%{ opacity:.45;transform:scale(.85); }
}
.sync-label{ font-weight:600;color:var(--text-1); }
.sync-time{ margin-left:auto;font-size:var(--fs-xs);color:var(--text-3); }

.sync-msg{
  padding:10px 12px;
  border-radius:var(--r-sm);
  background:var(--danger-50);
  color:var(--danger-ink);
  font-size:var(--fs-xs);
  line-height:1.55;
}
.sync-tables{
  font-size:var(--fs-xs);
  color:var(--text-3);
  line-height:1.6;
}
.sync-btn{
  width:100%;
  min-height:calc(42px);
  font-size:var(--fs-sm);
}

/* 行尾箭头：两条边框旋转 45° */
.chev-right{
  flex:none;
  width:8px;height:8px;
  margin-left:4px;
  border-top:2px solid var(--text-4);
  border-right:2px solid var(--text-4);
  transform:rotate(45deg);
}

.ph{ color:var(--text-4); }

/* ---------- 分享分叉（模仿 H5 第 17 轮） ---------- */

/* 分享：向上箭头（下载图标的镜像） */
.ico-share::before{
  left:7.5px;top:5px;
  width:1.8px;height:11px;
  background:currentColor;
  border-radius:1px;
}
.ico-share::after{
  left:4.5px;top:2px;
  width:8px;height:8px;
  border-left:1.8px solid currentColor;
  border-top:1.8px solid currentColor;
  transform:rotate(45deg);
  transform-origin:60% 60%;
  box-sizing:border-box;
}

/* 重新载入：缺口圆环 + 箭头（基准 btnRefork 的图标） */
.ico-refresh::before{
  left:1.5px;top:1.5px;
  width:13px;height:13px;
  border:1.8px solid currentColor;
  border-radius:50%;
  border-left-color:transparent;
  box-sizing:border-box;
  transform:rotate(-45deg);
}
.ico-refresh::after{
  left:10.5px;top:-1px;
  width:5px;height:5px;
  border-top:1.8px solid currentColor;
  border-right:1.8px solid currentColor;
  transform:rotate(-15deg);
  box-sizing:border-box;
}

/* 分享卡：独立一张，不再伪装成设置行。
   open-type="share" 只能用 button 触发，所以按钮本身仍是原生 button，
   这里只负责把它做成品牌色胶囊。 */
.share-card{
  /* 上下都要留卡片间距：下面的「偏好设置」是 .card，
     但 .card + .card 的 margin-top 只对相邻两张 .card 生效 */
  margin:var(--gap-card) 0;
  padding:16px var(--pad-card);
  background:var(--surface);
  border-radius:var(--r-lg);
  box-shadow:var(--sh-2);
}
.share-head{
  display:flex;
  align-items:center;
  gap:12px;
}
.share-badge{
  flex:none;
  width:36px;height:36px;
  border-radius:var(--r-sm);
  background:var(--brand-50);
  display:flex;align-items:center;justify-content:center;
}
.share-copy{
  flex:1;min-width:0;
  display:flex;flex-direction:column;gap:2px;
}
.share-title{
  font-size:var(--fs-body);
  font-weight:700;
  color:var(--text-1);
}
.share-sub{
  font-size:var(--fs-xs);
  color:var(--text-3);
  line-height:1.45;
}
.share-btn{
  display:flex;align-items:center;justify-content:center;
  width:100%;
  height:40px;
  margin:12px 0 0;
  padding:0 18px;
  border:none;
  border-radius:var(--r-pill);
  background:var(--brand-gradient);
  color:#fff;
  font-size:var(--fs-body);
  font-weight:700;
  line-height:1;
  box-shadow:var(--sh-accent);
  transition:transform .12s ease-out,filter .12s;
}
.share-btn::after{ border:none; }
.share-btn.is-press{ transform:scale(.96); filter:brightness(.97); }

/* hover-class 按压态 */
.mine-btn.is-press{ background:rgba(120,120,128,.16);box-shadow:none; }

/* =====================================================================
   B 方案图标：圆润品牌线性（2.4 stroke → 21px 下约 2.1px）
   全部是内联 SVG mask，颜色由 .mine-ico 的 currentColor 决定。
   ===================================================================== */

