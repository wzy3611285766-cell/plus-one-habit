/* 我的 —— 对齐 design-baseline.html 的 #panel-mine（第 915–1000 / 1259 行）
 *
 * 形态是 iOS 设置页：分组卡片 + 发丝分隔线 + 行内按下高光。
 * 与基准的唯一结构差异：顶部多一行「账号」，否则未登录时没有登录入口。
 */

.mine{ padding-bottom:calc(var(--pad-nav) + 20rpx); }

/* =====================================================================
   分组列表
   ===================================================================== */
.card-title .title-dot{
  flex:none;
  width:3px;height:14px;
  border-radius:2px;
  background:var(--brand-500);
}
.title-dot.is-green{ background:var(--success-500); }

.mine-list{ margin:0 calc(var(--pad-card) * -1); }

.mine-btn{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:52px;
  padding:10px var(--pad-card);
  border-bottom:.5px solid var(--line);
  background:none;
  font-size:var(--fs-body);
  font-weight:500;
  color:var(--text-1);
  transition:background .14s ease-out,box-shadow .14s ease-out;
}
.mine-list .mine-btn:last-child,
.mine-list .mine-vol:last-child{ border-bottom:0; }
.mine-btn:active{
  background:rgba(0,122,255,.09);
  box-shadow:inset 0 .5px 0 rgba(255,255,255,.55);
}
.mine-btn.danger{ color:var(--danger-ink); }
.mine-btn.danger .mine-ico{ color:var(--danger-500); }
.mine-btn.danger:active{ background:rgba(255,59,48,.10); }

.mine-body{
  flex:1;
  min-width:0;
  display:flex;
  flex-direction:column;
  text-align:left;
}
.mine-txt{
  display:block;
  font-size:var(--fs-body);
  font-weight:500;
  color:inherit;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.mine-sub{
  display:block;
  margin-top:1px;
  font-size:var(--fs-nano);
  font-weight:400;
  color:var(--text-3);
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}

/* ---------- 行内图标（24×24 线性图标的 CSS 复刻，17px） ---------- */
.mine-ico{
  flex:none;
  position:relative;
  width:17px;
  height:17px;
  color:var(--brand-500);
}
.mine-ico::before,
.mine-ico::after{
  content:"";
  position:absolute;
}

/* 人形：头 + 肩 */
.ico-user::before{
  left:5.5px;top:0;
  width:6px;height:6px;
  border:1.6px solid currentColor;
  border-radius:50%;
  box-sizing:border-box;
}
.ico-user::after{
  left:2px;top:9px;
  width:13px;height:6px;
  border:1.6px solid currentColor;
  border-bottom:0;
  border-radius:50% 50% 0 0 / 100% 100% 0 0;
  box-sizing:border-box;
}

/* 音效：喇叭 */
.ico-sound::before{
  left:1px;top:5px;
  width:5px;height:6px;
  background:currentColor;
  border-radius:1px;
}
.ico-sound::after{
  left:5px;top:3px;
  width:0;height:0;
  border-left:6px solid currentColor;
  border-top:5px solid transparent;
  border-bottom:5px solid transparent;
}

/* 音量：三根高低竖条 */
.ico-vol::before{
  left:1px;top:7px;
  width:2.4px;height:3px;
  background:currentColor;
  border-radius:1px;
  box-shadow:4px -4px 0 currentColor, 8px -7px 0 currentColor;
}
.ico-vol::after{
  left:1px;bottom:0;
  width:10.4px;height:2.4px;
  border-radius:2px;
  background:transparent;
}

/* 深色模式：月亮 */
.ico-theme::before{
  left:1px;top:1px;
  width:13px;height:13px;
  border:1.6px solid currentColor;
  border-radius:50%;
  box-sizing:border-box;
  background:transparent;
}
.ico-theme::after{
  left:6px;top:-1px;
  width:13px;height:15px;
  border-radius:50%;
  background:var(--surface);
  box-shadow:inset 1px 0 0 0 var(--surface);
}

/* 震动：两根波浪线 */
.ico-vibe::before{
  left:2px;top:3px;
  width:1.8px;height:11px;
  border-radius:1px;
  background:currentColor;
}
.ico-vibe::after{
  left:9px;top:3px;
  width:1.8px;height:11px;
  border-radius:1px;
  background:currentColor;
  box-shadow:3.5px 0 0 currentColor;
}

/* 下载：箭头 + 底线 */
.ico-download::before{
  left:7.5px;top:1px;
  width:1.8px;height:8px;
  background:currentColor;
}
.ico-download::after{
  left:4.5px;top:6px;
  width:8px;height:8px;
  border-right:1.8px solid currentColor;
  border-bottom:1.8px solid currentColor;
  transform:rotate(45deg);
  transform-origin:60% 60%;
  box-sizing:border-box;
}

/* 垃圾桶：盖子 + 桶身 */
.ico-trash::before{
  left:1px;top:2px;
  width:15px;height:1.8px;
  border-radius:1px;
  background:currentColor;
}
.ico-trash::after{
  left:3px;top:4px;
  width:11px;height:12px;
  border:1.6px solid currentColor;
  border-top:0;
  border-radius:0 0 2px 2px;
  box-sizing:border-box;
}

/* 云端：云朵 */
.ico-cloud::before{
  left:1px;top:5px;
  width:14px;height:8px;
  border:1.6px solid currentColor;
  border-radius:999rpx;
  box-sizing:border-box;
}

/* 退出：门 + 箭头 */
.ico-out::before{
  left:1px;top:1px;
  width:9px;height:15px;
  border:1.6px solid currentColor;
  border-right:0;
  border-radius:2px 0 0 2px;
  box-sizing:border-box;
}
.ico-out::after{
  left:9px;top:8px;
  width:7px;height:1.8px;
  background:currentColor;
}

/* =====================================================================
   iOS 开关
   ===================================================================== */
.switch{
  position:relative;
  flex:none;
  width:46px;
  height:28px;
  border-radius:999rpx;
  background:rgba(120,120,128,.22);
  transition:background .2s ease-out;
}
.switch.on{ background:var(--brand-500); }
.knob{
  position:absolute;
  left:2px;top:2px;
  width:24px;height:24px;
  border-radius:50%;
  background:#fff;
  box-shadow:0 2px 4px rgba(0,0,0,.18),0 0 0 .5px rgba(0,0,0,.04);
  transition:transform .2s cubic-bezier(.22,1,.36,1);
}
.switch.on .knob{ transform:translateX(18px); }

/* =====================================================================
   音量滑块
   ===================================================================== */
.mine-vol{
  display:flex;
  align-items:center;
  gap:12px;
  width:100%;
  min-height:52px;
  padding:10px var(--pad-card);
  border-bottom:.5px solid var(--line);
}
.vol-range{
  flex:none;
  width:106px;
  margin:0;
}

/* =====================================================================
   在线同步
   ===================================================================== */
.sync-box{ display:flex;flex-direction:column;gap:10px; }

.sync-row{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:var(--fs-sm);
  color:var(--text-2);
}
.sync-dot{
  flex:none;
  width:9px;height:9px;
  border-radius:50%;
  background:var(--text-4);
}
.sync-dot.ok{ background:var(--success-500); }
.sync-dot.sync{ background:var(--brand-500);animation:syncPulse 1.1s ease-in-out infinite; }
.sync-dot.err{ background:var(--danger-500); }
.sync-dot.off{ background:var(--text-4); }
@keyframes syncPulse{
  0%,100%{ opacity:1;transform:scale(1); }
  50%{ opacity:.45;transform:scale(.85); }
}
.sync-label{ font-weight:600;color:var(--text-1); }
.sync-time{ margin-left:auto;font-size:var(--fs-xs);color:var(--text-3); }

.sync-msg{
  padding:10px 12px;
  border-radius:var(--r-sm);
  background:var(--danger-50);
  color:var(--danger-ink);
  font-size:var(--fs-xs);
  line-height:1.55;
}
.sync-tables{
  font-size:var(--fs-xs);
  color:var(--text-3);
  line-height:1.6;
}
.sync-btn{
  width:100%;
  min-height:calc(42px);
  font-size:var(--fs-sm);
}

/* 行尾箭头：两条边框旋转 45° */
.chev-right{
  flex:none;
  width:8px;height:8px;
  margin-left:4px;
  border-top:2px solid var(--text-4);
  border-right:2px solid var(--text-4);
  transform:rotate(45deg);
}

.ph{ color:var(--text-4); }

/* ---------- 分享分叉（模仿 H5 第 17 轮） ---------- */

/* 分享：向上箭头（下载图标的镜像） */
.ico-share::before{
  left:7.5px;top:5px;
  width:1.8px;height:11px;
  background:currentColor;
  border-radius:1px;
}
.ico-share::after{
  left:4.5px;top:2px;
  width:8px;height:8px;
  border-left:1.8px solid currentColor;
  border-top:1.8px solid currentColor;
  transform:rotate(45deg);
  transform-origin:60% 60%;
  box-sizing:border-box;
}

/* 重新载入：缺口圆环 + 箭头（基准 btnRefork 的图标） */
.ico-refresh::before{
  left:1.5px;top:1.5px;
  width:13px;height:13px;
  border:1.8px solid currentColor;
  border-radius:50%;
  border-left-color:transparent;
  box-sizing:border-box;
  transform:rotate(-45deg);
}
.ico-refresh::after{
  left:10.5px;top:-1px;
  width:5px;height:5px;
  border-top:1.8px solid currentColor;
  border-right:1.8px solid currentColor;
  transform:rotate(-15deg);
  box-sizing:border-box;
}

/* 分享行是 button（open-type="share" 只有 button 能触发），
   其余形态与 .mine-btn 完全一致：抹掉原生按钮的三件套 */
.mine-btn-share{
  border:none;
  border-radius:0;
  margin:0;
  line-height:inherit;
}
.mine-btn-share::after{ border:none; }
