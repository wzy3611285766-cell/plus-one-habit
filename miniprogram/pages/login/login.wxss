/* 登录 / 注册 / 找回密码 */

.login-page{
  padding-top:clamp(24px,7vw,44px);
}

/* ---------- 品牌区 ---------- */
.brand{
  text-align:center;
  margin-bottom:clamp(20px,5vw,30px);
}
.brand-mark{
  width:calc(64px);
  height:calc(64px);
  margin:0 auto 14px;
  border-radius:calc(20px);
  background:var(--brand-gradient);
  color:var(--text-on-accent);
  font-size:calc(24px);
  font-weight:800;
  letter-spacing:var(--ls-tight);
  display:flex;align-items:center;justify-content:center;
  box-shadow:var(--sh-accent);
}
.brand-title{
  font-size:var(--fs-h1);
  font-weight:800;
  letter-spacing:var(--ls-tight);
  color:var(--text-1);
}
.brand-sub{
  margin-top:8px;
  font-size:var(--fs-sm);
  color:var(--text-3);
  line-height:1.6;
  padding:0 24px;
}

/* ---------- 提示条 ---------- */
.banner{
  display:flex;
  align-items:flex-start;
  gap:10rpx;
  margin-top:14px;
  padding:14rpx 16rpx;
  border-radius:var(--r-sm);
  font-size:var(--fs-sm);
  line-height:1.55;
}
.banner-dot{
  width:12rpx;height:12rpx;border-radius:50%;
  margin-top:9rpx;flex:none;background:currentColor;
}
.banner-err{ background:var(--danger-50); color:var(--danger-ink); }
.banner-brand{ background:var(--brand-50); color:var(--brand-600); }
.banner-text{ flex:1;min-width:0; }

/* 微信标记：两个错开的小圆，纯粹用几何暗示「两个气泡」 */
.wx-mark{
  position:relative;
  width:30rpx;height:26rpx;flex:none;
}
.wx-mark::before,.wx-mark::after{
  content:"";
  position:absolute;
  border-radius:50%;
  background:currentColor;
  opacity:.85;
}
.wx-mark::before{ left:0;top:0;width:20rpx;height:20rpx; }
.wx-mark::after{ right:0;bottom:0;width:14rpx;height:14rpx;opacity:.55; }

/* ---------- 一键登录 ---------- */
/* 微信绿：这是「微信身份」动作，用微信自己的绿比品牌蓝更好认 */
.btn-wx{
  display:flex;align-items:center;justify-content:center;gap:12rpx;
  width:100%;
  min-height:48px;
  border:none;
  border-radius:var(--r-pill);
  /* 微信品牌绿没有进 tint 体系，这里按 tint 玻璃的三件套现配一份：
     染色底（可降级的半透明）+ 模糊 + 上缘高光/发丝边/投影 */
  background:linear-gradient(180deg,rgba(255,255,255,.26) 0%,rgba(255,255,255,.05) 46%,rgba(255,255,255,0) 60%),linear-gradient(180deg,rgba(7,193,96,.56),rgba(7,193,96,.40));
  color:#fff;
  font-size:var(--fs-body);
  font-weight:700;
  letter-spacing:var(--ls-snap);
  -webkit-backdrop-filter:var(--gb-blur-liq);
  backdrop-filter:var(--gb-blur-liq);
  box-shadow:inset 0 .5px 0 rgba(255,255,255,.42),0 0 0 .5px rgba(4,140,68,.42),var(--gb-drop);
  transition:transform .12s ease-out, filter .15s;
}
.btn-wx:active{ transform:scale(.985); filter:brightness(.96); }
.btn-wx[disabled]{ opacity:.55; }

/* ---------- 底部 ---------- */
.login-foot{
  margin-top:clamp(22px,6vw,34px);
  text-align:center;
  font-size:var(--fs-xs);
}
.link{ color:var(--brand-500); }
/* 不登录的出口：给足点击面积，但仍保持次级（不跟一键登录抢注意力） */
.login-foot .link{ display:inline-block;padding:12rpx 24rpx; }

/* ---------- 未配置环境的引导 ---------- */
.setup-list{
  margin-top:16px;
  display:flex;
  flex-direction:column;
  gap:12px;
}
.setup-item{
  display:flex;
  gap:12rpx;
  align-items:flex-start;
}
.setup-no{
  flex:none;
  width:32rpx;height:32rpx;
  border-radius:50%;
  background:var(--brand-50);
  color:var(--brand-600);
  font-size:var(--fs-nano);
  font-weight:700;
  text-align:center;
  line-height:32rpx;
}
.setup-txt{
  flex:1;
  font-size:var(--fs-sm);
  color:var(--text-2);
  line-height:1.6;
}
