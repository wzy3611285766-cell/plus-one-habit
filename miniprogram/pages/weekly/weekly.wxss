/* 周报复盘 —— 对齐 design-baseline.html 的 #panel-weekly（第 1256–1290 行）
 *
 * 两段式：上面是「这一周的客观数据」，下面是 KPT 纸感复盘。
 * 输入框只有一条下边线（纸感），不是常见的圆角描边盒子 —— 这是基准的形态。
 */

.weekly{ padding-bottom:calc(var(--pad-nav) + 20rpx); }

/* =====================================================================
   周切换
   ===================================================================== */
.week-card{ margin-top:var(--gap-card); }

.week-nav{
  display:flex;
  align-items:center;
  gap:10px;
  margin-bottom:14px;
}
/* .btn 是全局类（width:100%），这里要收成自动宽度的胶囊 */
.week-btn{
  flex:none;
  width:auto;
  min-height:calc(44px);
  padding:0 14px;
  font-size:var(--fs-sm);
}
.week-btn.is-off{ visibility:hidden; }
.week-label{
  flex:1;
  min-width:0;
  text-align:center;
  font-size:var(--fs-sm);
  font-weight:700;
  color:var(--text-1);
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

/* =====================================================================
   本周汇总
   ===================================================================== */
.week-empty{
  padding:20px 0;
  text-align:center;
  font-size:var(--fs-sm);
  color:var(--text-3);
}

.week-summary-row{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  padding:8px 0;
  border-bottom:1px solid var(--line-soft);
  font-size:var(--fs-body);
}
.week-summary-row:last-child{ border-bottom:none; }

.wsr-name{
  display:flex;
  align-items:center;
  gap:6px;
  min-width:0;
  flex:1;
}
.goal-color-dot{
  flex:none;
  width:12px;height:12px;
  border-radius:4px;
}
.wsr-text{
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  color:var(--text-1);
}

.week-summary-row .vals{
  flex:none;
  max-width:62%;
  text-align:right;
  font-size:var(--fs-sm);
  color:var(--text-2);
  line-height:1.5;
}
.wsr-sum{
  color:var(--text-1);
  font-weight:700;
}
.wsr-strong{
  color:var(--text-1);
  font-weight:700;
}
.week-compare{
  margin-top:2px;
  font-size:var(--fs-nano);
  color:var(--text-3);
}

.week-total{
  margin-top:4px;
  padding-top:10px;
  border-top:1px solid var(--line);
  border-bottom:none;
}
.wsr-total-k{ font-weight:700;color:var(--text-1); }

/* =====================================================================
   KPT 纸感复盘
   ===================================================================== */
.card-title .title-dot{
  flex:none;
  width:3px;height:14px;
  border-radius:2px;
  background:#f59e0b;
}

.kpt-row{ margin-bottom:10px; }
.kpt-label{
  display:block;
  margin-bottom:4px;
  font-size:var(--fs-sm);
  font-weight:600;
  color:var(--text-2);
}
.kpt-hint{
  font-size:var(--fs-xs);
  font-weight:400;
  color:var(--text-3);
}
/* 只有下边线：像在纸上写，而不是在表单里填 */
.kpt-input{
  width:100%;
  min-height:calc(38px);
  padding:0 2px;
  border:none;
  border-bottom:2px solid var(--line-strong);
  border-radius:0;
  background:transparent;
  font-size:var(--fs-body);
  color:var(--text-1);
}
.kpt-input:focus{
  border-bottom-color:var(--brand-400);
  box-shadow:0 6px 0 -4px rgba(0,122,255,.20);
}

.kpt-actions{
  display:flex;
  gap:10px;
  margin-top:10px;
}
.kpt-actions .btn{ flex:1; }

.ph{ color:var(--text-4); }

/* =====================================================================
   平板及以上
   ===================================================================== */
@media (min-width:640px){
  .week-label{ font-size:var(--fs-h3); }
  .week-card{ margin-top:0; }
}

/* =====================================================================
   往期复盘存档（备忘录/收藏的列表习惯：条目 + 一行摘录，点开细看）
   ===================================================================== */
.arc-list{ margin:0 calc(var(--pad-card) * -1); }
.arc-row{
  display:flex;align-items:center;gap:12px;
  min-height:52px;padding:10px var(--pad-card);
  border-bottom:.5px solid var(--line);
  transition:background .14s ease-out;
}
.arc-list .arc-row:last-child{ border-bottom:0; }
.arc-row:active{ background:rgba(120,120,128,.16); }
.arc-main{ flex:1;min-width:0;display:flex;flex-direction:column;gap:2px; }
.arc-week{ font-size:var(--fs-sm);font-weight:600;color:var(--text-1); }
.arc-snippet{
  font-size:var(--fs-xs);color:var(--text-3);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.arc-chev{
  flex:none;width:8px;height:8px;
  border-top:1.6px solid var(--text-4);
  border-right:1.6px solid var(--text-4);
  transform:rotate(45deg);
}

/* 往期复盘折叠头：标题行即开关，右侧「N 篇」+ 展开箭头 */
.arc-head{ cursor:pointer; }
.arc-meta{ margin-left:auto;display:flex;align-items:center;gap:6px; }
.arc-count{ font-size:var(--fs-xs);font-weight:600;color:var(--text-3); }
.arc-toggle{
  width:8px;height:8px;
  border-right:1.6px solid var(--text-3);
  border-bottom:1.6px solid var(--text-3);
  transform:rotate(45deg);
  transition:transform .18s ease-out;
}
.arc-toggle.is-open{ transform:rotate(-135deg); }

/* hover-class 按压态 */
.arc-row.is-press{ background:rgba(120,120,128,.16); }
