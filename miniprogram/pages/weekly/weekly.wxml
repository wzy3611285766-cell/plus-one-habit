<view class="page weekly {{themeClass}}">

  <app-hero />

  <!-- ---------- 卡片一：周切换 + 本周汇总 ---------- -->
  <view class="card week-card">
    <view class="week-nav">
      <view class="btn btn-ghost week-btn" bindtap="prevWeek">上一周</view>
      <text class="week-label">{{range}}{{isCurrent ? '（本周）' : ''}}</text>
      <view class="btn btn-ghost week-btn {{isCurrent ? 'is-off' : ''}}" bindtap="nextWeek">下一周</view>
    </view>

    <view wx:if="{{!summary.length}}" class="week-empty">这一周还没有打卡记录</view>

    <block wx:else>
      <view wx:for="{{summary}}" wx:key="gid" class="week-summary-row">
        <view class="wsr-name">
          <view class="goal-color-dot" style="background:{{item.color}}"></view>
          <text class="wsr-text">{{item.name}}</text>
        </view>
        <view class="vals">
          <text wx:if="{{item.hasSum}}" class="wsr-sum num">+{{item.sum}}</text>
          <text wx:if="{{item.hasSum}}"> {{item.unit }} · </text>
          <text>打卡 <text class="wsr-strong num">{{item.days}}</text> 天</text>
          <view wx:if="{{item.compare}}" class="week-compare">上周 {{item.compare}}</view>
        </view>
      </view>

      <view class="week-summary-row week-total">
        <text class="wsr-total-k">合计打卡</text>
        <view class="vals">
          <text class="wsr-strong num">{{totals.count}}</text> 次
          <view wx:if="{{totals.prevCount > 0}}" class="week-compare">上周 {{totals.prevCount}} 次</view>
        </view>
      </view>
    </block>
  </view>

  <!-- ---------- 卡片二：KPT 纸感复盘 ---------- -->
  <view class="card">
    <view class="card-title">
      <view class="title-dot"></view>
      <text>本周复盘</text>
    </view>

    <view class="kpt-row">
      <text class="kpt-label">保持 Keep<text class="kpt-hint"> · 做得好的，下周继续</text></text>
      <input
        class="kpt-input"
        value="{{form.keep}}"
        data-field="keep"
        bindinput="onField"
        maxlength="100"
        placeholder="例：单词连续 6 天没断"
        placeholder-class="ph"
      />
    </view>

    <view class="kpt-row">
      <text class="kpt-label">问题 Problem<text class="kpt-hint"> · 卡在哪了</text></text>
      <input
        class="kpt-input"
        value="{{form.problem}}"
        data-field="problem"
        bindinput="onField"
        maxlength="100"
        placeholder="例：阅读总拖到睡前，一躺下就刷手机"
        placeholder-class="ph"
      />
    </view>

    <view class="kpt-row">
      <text class="kpt-label">尝试 Try<text class="kpt-hint"> · 下周试试这样改</text></text>
      <input
        class="kpt-input"
        value="{{form.try}}"
        data-field="try"
        bindinput="onField"
        maxlength="100"
        placeholder="例：阅读改到午饭后 20 分钟"
        placeholder-class="ph"
      />
    </view>

    <view class="kpt-row">
      <text class="kpt-label">下周预案<text class="kpt-hint"> · 如果…我就…</text></text>
      <input
        class="kpt-input"
        value="{{form.next}}"
        data-field="next"
        bindinput="onField"
        maxlength="100"
        placeholder="例：如果睡前想刷手机，我就先把书读 2 页"
        placeholder-class="ph"
      />
    </view>

    <view class="kpt-actions">
      <button class="btn btn-ghost" bindtap="save">保存复盘</button>
      <button class="btn btn-primary" bindtap="generate">生成周报文本</button>
    </view>

    <view wx:if="{{hasReport}}" class="report-box">
      <view class="report-preview">{{report}}</view>
      <button class="btn btn-green" bindtap="copyReport">一键复制周报</button>
    </view>
  </view>
</view>
